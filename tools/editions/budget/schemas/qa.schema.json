{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "aigile-budget/qa.schema.json",
  "title": "QA artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_id", "implementation_ref", "checks", "verdict"],
  "properties": {
    "artifact_id": { "type": "string", "pattern": "^QA-\\d{4}-\\d{2}-\\d{2}-\\d{3}$" },
    "implementation_ref": { "type": "string", "pattern": "^IMPL-" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pass", "fail", "warn"] },
          "evidence": { "type": "string" }
        }
      }
    },
    "defects": { "type": "array", "items": { "type": "string" } },
    "verdict": { "enum": ["go", "no-go", "conditional"] },
    "notes": { "type": "string" }
  }
}
