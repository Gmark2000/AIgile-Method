{
  "name": "@mark-gozner/aigile-method",
  "version": "1.5.0",
  "description": "AIgile Development Method by Mark Gozner - AI-powered development with custom agents (Claude Code, GitHub Copilot, OpenAI Codex, Google Antigravity & Kiro), skills, deterministic workflows, handoffs, and delegation",
  "private": false,
  "license": "SEE LICENSE",
  "bin": {
    "aigile": "tools/cli.js",
    "aigile-method": "tools/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test tools/tests/*.test.js",
    "sync:clients": "node tools/sync-client-assets.js --write",
    "check:clients": "node tools/sync-client-assets.js",
    "test:package": "node tools/sync-client-assets.js --pack",
    "bundle": "node tools/cli.js bundle",
    "build": "node tools/cli.js bundle",
    "validate": "node tools/cli.js bundle && node tools/validate-bundles.js",
    "prepack": "node tools/sync-client-assets.js --write --pack",
    "prepublishOnly": "npm test",
    "pack:dry-run": "npm pack --dry-run",
    "release:patch": "npm version patch && npm publish",
    "release:minor": "npm version minor && npm publish",
    "release:major": "npm version major && npm publish",
    "list:agents": "node -e \"const fs=require('fs'); const p=require('path'); const d=p.join('core','agents'); console.log('Available agents:'); if(fs.existsSync(d)) for(const f of fs.readdirSync(d)) if(f.endsWith('.md')) console.log('  - '+f.replace(/\\.md$/, ''));\"",
    "install:aigile": "node tools/cli.js install",
    "postinstall": "node tools/postinstall.js",
    "aigile:install": "aigile-method install --yes",
    "aigile:bundle": "aigile-method bundle",
    "aigile:status": "aigile-method status",
    "aigile:list": "aigile-method list:agents",
    "aigile:plugin": "node tools/cli.js bundle"
  },
